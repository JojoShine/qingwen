# Copy to .env.docker. Never commit the actual file.
# Password for the PostgreSQL database embedded in the image.
# Use `openssl rand -hex 24` to generate a strong password.
POSTGRES_PASSWORD=
# Optional: empty follows the current browser origin, including protocol and port.
APP_URL=
APP_BIND=127.0.0.1
APP_PORT=3218

# Created automatically on first startup; existing passwords are not overwritten.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=管理员

# Set only when a trusted reverse proxy overwrites this single-value header.
TRUSTED_CLIENT_IP_HEADER=

# Published by GitHub Actions. This single image includes PostgreSQL and the app.
# GHCR is the default; Docker Hub fallback: docker.io/jojoshine/qingwen with the same tag.
QINGWEN_IMAGE=ghcr.io/jojoshine/qingwen:latest

# Optional: publicly display an existing test account on the login page. Never use admin credentials.
# DEMO_USERNAME also protects this account from changing its password.
# To hide public credentials only, clear DEMO_PASSWORD and keep DEMO_USERNAME.
DEMO_USERNAME=
DEMO_PASSWORD=
