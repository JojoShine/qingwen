# Copy to .env.docker. Never commit the actual file.
# Use `openssl rand -hex 24` for a URL-safe database password.
POSTGRES_PASSWORD=
APP_URL=http://localhost:3218
APP_BIND=127.0.0.1
APP_PORT=3218

# Used only by the explicit `migrate pnpm db:seed` initialization command.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=管理员

# Set only when a trusted reverse proxy overwrites this single-value header.
TRUSTED_CLIENT_IP_HEADER=

# Local builds by default. Override both to deploy images from your own registry.
QINGWEN_IMAGE=qingwen:local
QINGWEN_MIGRATION_IMAGE=qingwen-migrate:local
