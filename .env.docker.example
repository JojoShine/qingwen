# Copy to .env.docker. Never commit the actual file.
# Use `openssl rand -hex 24` for a URL-safe database password.
POSTGRES_PASSWORD=
# Optional: empty follows the current browser origin, including protocol and port.
APP_URL=
APP_BIND=127.0.0.1
APP_PORT=3218

# Used only by the explicit `migrate pnpm db:seed` initialization command.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=管理员

# Set only when a trusted reverse proxy overwrites this single-value header.
TRUSTED_CLIENT_IP_HEADER=

# Published by GitHub Actions. Use the same sha-<commit> tag for both in production.
QINGWEN_IMAGE=ghcr.io/jojoshine/qingwen:latest
QINGWEN_MIGRATION_IMAGE=ghcr.io/jojoshine/qingwen-migrate:latest

# Optional: publicly display an existing test account on the login page. Never use admin credentials.
DEMO_USERNAME=
DEMO_PASSWORD=
