import 'dotenv/config';
import { chromium } from '@playwright/test';
import { mkdir } from 'node:fs/promises';
const browser=await chromium.launch({headless:true,executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'});
const context=await browser.newContext({viewport:{width:1440,height:1000}});
const page=await context.newPage();
const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));page.on('console',m=>{if(m.type()==='error')errors.push(m.text());});
await mkdir('artifacts',{recursive:true});
await page.goto('http://localhost:3218/login');
await page.screenshot({path:'artifacts/login-desktop.png',fullPage:true,caret:'initial'});
const login=await context.request.post('http://localhost:3218/api/auth/login',{data:{username:process.env.ADMIN_USERNAME,password:process.env.ADMIN_PASSWORD}});
if(!login.ok())throw new Error('Login failed');
await page.goto('http://localhost:3218/surveys');
await page.getByRole('heading',{name:'问卷库'}).waitFor();
await page.locator('.survey-card .card-title').first().waitFor();
await page.screenshot({path:'artifacts/workspace-desktop.png',fullPage:true,caret:'initial'});
const list=await(await context.request.get('http://localhost:3218/api/surveys')).json();
const draft=list.items.find((s:any)=>s.title.includes('新员工'));
await page.goto(`http://localhost:3218/surveys/${draft.id}/edit`);
await page.getByRole('button',{name:'发布问卷',exact:true}).waitFor();
await page.locator('.editor-block').first().waitFor();
await page.screenshot({path:'artifacts/editor-desktop.png',fullPage:true,caret:'initial'});
const active=list.items.find((s:any)=>s.title.includes('产品使用体验'));
await page.goto(`http://localhost:3218/surveys/${active.id}/results`);
await page.getByTestId('response-count').waitFor();
await page.screenshot({path:'artifacts/results-desktop.png',fullPage:true,caret:'initial'});
await page.setViewportSize({width:390,height:844});
await page.goto(`http://localhost:3218/s/${active.shareId}`);
await page.getByRole('button',{name:'提交问卷'}).waitFor();
await page.screenshot({path:'artifacts/survey-mobile.png',fullPage:true,caret:'initial'});
if(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth))throw new Error('Mobile overflow');
await page.goto('http://localhost:3218/surveys');
await page.locator('.survey-card .card-title').first().waitFor();
await page.screenshot({path:'artifacts/workspace-mobile.png',fullPage:true,caret:'initial'});
if(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth))throw new Error('Dashboard mobile overflow');
console.log(JSON.stringify({screenshots:6,pageErrors:errors},null,2));
await browser.close();
