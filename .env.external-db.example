# Copy to .env.external-db. Existing host PostgreSQL; no database container is created.
# Example: postgresql://qingwen_app:URL_ENCODED_PASSWORD@host.docker.internal:5432/qingwen?schema=public
DATABASE_URL=
APP_URL=
APP_BIND=127.0.0.1
APP_PORT=3218
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=管理员
TRUSTED_CLIENT_IP_HEADER=
# App and migrate use this same image from Docker Hub.
QINGWEN_IMAGE=docker.io/jojoshine/qingwen:latest-surveys

# Optional: publicly display an existing test account on the login page. Never use admin credentials.
# DEMO_USERNAME also protects this account from changing its password.
# To hide public credentials only, clear DEMO_PASSWORD and keep DEMO_USERNAME.
DEMO_USERNAME=
DEMO_PASSWORD=
