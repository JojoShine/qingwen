# Copy to .env.external-db. Existing host PostgreSQL; no database container is created.
# Example: postgresql://qingwen_app:URL_ENCODED_PASSWORD@host.docker.internal:5432/qingwen?schema=public
DATABASE_URL=
APP_URL=
APP_BIND=127.0.0.1
APP_PORT=3218
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=管理员
TRUSTED_CLIENT_IP_HEADER=
QINGWEN_IMAGE=ghcr.io/jojoshine/qingwen:latest-surveys
QINGWEN_MIGRATION_IMAGE=ghcr.io/jojoshine/qingwen-migrate:latest
