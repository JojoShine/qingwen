{
  "name": "qingwen-survey",
  "version": "1.0.0",
  "description": "轻问：基于 Next.js、Ant Design 和 PostgreSQL 的轻量开源问卷系统",
  "license": "MIT",
  "author": "JojoShine",
  "repository": { "type": "git", "url": "https://github.com/JojoShine/qingwen.git" },
  "homepage": "https://github.com/JojoShine/qingwen#readme",
  "bugs": { "url": "https://github.com/JojoShine/qingwen/issues" },
  "packageManager": "pnpm@10.26.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3218",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 3218",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "tsx prisma/demo.ts"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "antd": "6.6.6",
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.1",
    "dotenv": "17.4.2",
    "dayjs": "1.11.23",
    "zod": "4.6.7",
    "prisma": "7.10.0",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/yauzl": "3.4.0",
    "typescript": "5.9.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
